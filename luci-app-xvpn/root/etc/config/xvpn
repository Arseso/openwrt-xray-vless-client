
config general 'main'
	option enabled '0'
	option xray_bin '/usr/bin/xray'
	option loglevel 'warning'
	option tproxy_port '12345'
	option dns_port '10853'
	option api_port '10085'
	option test_port_base '20000'
	option client_mark '0x01000000'
	option tproxy_mark '0x02000000'
	option route_table '100'
	option sniffing '1'

config access 'access'
	option killswitch '1'
	option ipv6 'block'
	option dns_hijack '1'
	option dns_server 'https://cloudflare-dns.com/dns-query'

config health 'health'
	option url 'https://www.gstatic.com/generate_204'
	option interval '30'
	option timeout '5'
	option fail_threshold '3'
	option rank_interval '600'
	option auto_best '0'
	option hysteresis '150'
	option quarantine '300'
	option concurrency '8'

config manual 'manual'
