#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT

USE_PROCD=1
START=95
STOP=10

CLI="/usr/bin/ucode /usr/share/xvpn/cli.uc"
CONF=/var/etc/xvpn/config.json

start_service() {
	config_load xvpn
	local enabled xray_bin gomemlimit gogc
	config_get_bool enabled main enabled 0
	config_get xray_bin main xray_bin /usr/bin/xray
	# Go GC of xray on a 256 MB router (DESIGN.md 6.4); not in the default config
	config_get gomemlimit main gomemlimit 80MiB
	config_get gogc main gogc 50
	# Go stops the binary on a value it cannot parse ("80MB"): xray would not start at all
	local n=${gomemlimit%B}; n=${n%[KMGT]i}
	case "$gomemlimit:$n" in
	off:*) ;;
	*:|*:*[!0-9]*) logger -t xvpn "main.gomemlimit '$gomemlimit' is not like 80MiB or off, using 80MiB"; gomemlimit=80MiB ;;
	esac
	case "$gogc" in
	off) ;;
	''|*[!0-9]*) logger -t xvpn "main.gogc '$gogc' is not a number or off, using 50"; gogc=50 ;;
	esac

	# VPN SSIDs get fixed names (xvpn-apN), deselected ones get theirs back; also when turned off,
	# after fw-remove, which clears the warnings of the rules
	if [ "$enabled" != 1 ]; then
		$CLI fw-remove
		$CLI ifnames
		return 0
	fi
	$CLI ifnames

	# generate drops servers that xray rejects; 3: no servers, 4: xray does not work,
	# 5: out of time, xray goes on with the config it runs
	local have_servers=1 rc=0
	# its `xray run -test` with the same GC as xray
	GOMEMLIMIT="$gomemlimit" GOGC="$gogc" $CLI generate >/dev/null || rc=$?
	[ "$rc" = 0 ] || { [ "$rc" = 5 ] && [ -s "$CONF" ]; } || have_servers=0

	# rules stay in place without servers: with kill switch on, clients stay offline instead of leaking;
	# if nft rejects them, cli.uc blocks the clients and the status shows "error"
	$CLI fw-apply || logger -t xvpn "failed to apply firewall rules, VPN clients are blocked"

	if [ "$have_servers" = 1 ]; then
		procd_open_instance xray
		procd_set_param command "$xray_bin" run -c "$CONF"
		procd_set_param env GOMEMLIMIT="$gomemlimit" GOGC="$gogc"
		procd_set_param file "$CONF"
		procd_set_param limits nofile="65535 65535"
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_set_param respawn 3600 5 0
		procd_close_instance
	fi

	procd_open_instance xvpnd
	procd_set_param command /usr/bin/ucode /usr/share/xvpn/xvpnd.uc
	# for its own `xray run -test`
	procd_set_param env GOMEMLIMIT="$gomemlimit" GOGC="$gogc"
	procd_set_param file /etc/config/xvpn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

stop_service() {
	config_load xvpn
	local on
	config_get_bool on main enabled 0

	# restart, upgrade and shutdown keep the clients behind the guard until xray is back;
	# rules go away only when the service is turned off or disabled (package removal disables it first)
	if [ "$on" = 1 ] && enabled; then
		$CLI fw-guard
	else
		$CLI fw-remove
	fi
}

# start and every reload, whoever runs it (the daemon, rpcd, UCI triggers): the rules are
# applied and procd restarts xray now, so the daemon re-reads the index and settles from here
service_started() {
	ubus -t 2 call xvpn reindex >/dev/null 2>&1 || true
}

service_triggers() {
	procd_add_reload_trigger xvpn wireless network
}
