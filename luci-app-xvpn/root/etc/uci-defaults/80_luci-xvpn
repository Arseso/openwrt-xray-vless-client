#!/bin/sh

mkdir -p /etc/xvpn/subs
# postinst does not enable new init scripts on upgrade
/etc/init.d/xvpn-guard enable

# fw4 flush deletes our tables too: the include restores them after firewall start/reload
uci -q get firewall.xvpn >/dev/null || uci -q batch <<EOF
set firewall.xvpn=include
set firewall.xvpn.type=script
set firewall.xvpn.path=/usr/share/xvpn/firewall.include
set firewall.xvpn.fw4_compatible=1
commit firewall
EOF
# SSID names are fixed in /etc/config/wireless now, the cache of the old versions is not used
rm -f /etc/xvpn/ifnames.json
rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache
exit 0
