// SPDX-License-Identifier: MIT
// rpcd plugin for luci-app-xvpn: data that is available without the daemon.

'use strict';

import { readfile, popen } from 'fs';
import { cursor } from 'uci';
import { connect } from 'ubus';
import { load_config, read_json, run, shq, update_running, INDEX_FILE, ACTIVE_FILE } from 'xvpn.util';
import { all_servers, load_cache, load_status, due_in } from 'xvpn.subscription';

const CLI = '/usr/share/xvpn/cli.uc';
const INIT = '/etc/init.d/xvpn';

import { FW_WANT_FILE, FW_MODE_FILE, FW_ERROR_FILE } from 'xvpn.util';

function bg(cmd) {
	system(`(${cmd}) >/dev/null 2>&1 </dev/null &`);
}

// LuCI cannot call the daemon itself: uhttpd adds ubus_rpc_session to the arguments
// and the ucode ubus object rejects arguments missing from its policy
function daemon(method, args) {
	return connect()?.call('xvpn', method, args ?? {});
}

const methods = {
	status: {
		call: function() {
			let d = daemon('status');
			return d ? { running: true, ...d } : { running: false };
		}
	},

	test: {
		call: function() {
			return daemon('test') ?? { ok: false, error: 'not running' };
		}
	},

	select: {
		args: { id: 'id' },
		call: function(req) {
			if (!req.args?.id)
				return { ok: false, error: 'invalid id' };
			return daemon('select', { id: req.args.id }) ?? { ok: false, error: 'not running' };
		}
	},

	servers: {
		call: function() {
			let cfg = load_config();
			let list = map(all_servers(cfg), (s) => ({
				id: s.id, name: s.name, proto: s.proto, address: s.address, port: s.port,
				sub: s.sub, sub_name: s.sub_name,
			}));
			return { servers: list, active: trim(readfile(ACTIVE_FILE) ?? '') || null };
		}
	},

	subscriptions: {
		call: function() {
			let cfg = load_config();
			let subs = map(cfg.subscriptions, (s) => {
				let c = load_cache(s.id), st = load_status(s.id);
				return {
					id: s.id, name: s.name, enabled: s.enabled,
					count: length(c?.servers ?? []), skipped: c?.skipped, format: c?.format,
					title: c?.title, updated: c?.updated,
					last_ok: st.last_ok, last_attempt: st.last_attempt, error: st.error,
					userinfo: st.userinfo, via: st.via,
					due_in: s.enabled ? due_in(s) : null,
				};
			});
			// the daemon also counts the moment before `cli.uc update` takes the lock
			let d = connect()?.call('xvpn', 'status');
			return { subscriptions: subs, updating: d ? !!d.updating : !!update_running() };
		}
	},

	update: {
		args: { sid: 'sid' },
		call: function(req) {
			let sid = req.args?.sid || null;
			// the daemon is the single entry point: it updates, reloads and re-reads the index
			let r = connect()?.call('xvpn', 'update', sid ? { sid } : {});
			if (r)
				return r;

			// no daemon (service disabled or being restarted by procd): the lock in cli.uc
			// keeps it the one update at a time, the daemon picks up the reload by itself
			if (update_running())
				return { ok: false, error: 'busy' };
			bg(sprintf('/usr/bin/ucode %s update %s && %s running && %s reload', CLI, shq(sid ?? 'all'), INIT, INIT));
			return { ok: true };
		}
	},

	access_points: {
		call: function() {
			let uci = cursor();
			let networks = [], ports = [], wifi = [];

			uci.foreach('network', 'interface', (s) => {
				if (s['.name'] == 'loopback' || match(s['.name'], /^wan/))
					return;
				push(networks, { name: s['.name'], proto: s.proto, device: s.device });
			});

			uci.foreach('network', 'device', (s) => {
				if (s.type != 'bridge')
					return;
				for (let p in (type(s.ports) == 'array' ? s.ports : (s.ports ? [ s.ports ] : [])))
					push(ports, { name: p, bridge: s.name });
			});

			uci.foreach('wireless', 'wifi-iface', (s) => {
				if (s.mode && s.mode != 'ap')
					return;
				let dev = uci.get_all('wireless', s.device) ?? {};
				push(wifi, {
					section: s['.name'], ssid: s.ssid, radio: s.device, band: dev.band,
					network: s.network, disabled: (s.disabled == '1' || dev.disabled == '1'),
				});
			});

			return {
				networks, ports, wifi,
				flow_offloading: uci.get('firewall', '@defaults[0]', 'flow_offloading') == '1',
				flow_offloading_hw: uci.get('firewall', '@defaults[0]', 'flow_offloading_hw') == '1',
			};
		}
	},

	stats: {
		call: function() {
			let cfg = load_config(), idx = read_json(INDEX_FILE) ?? {};
			let r = run(sprintf('%s api statsquery --server=127.0.0.1:%d 2>/dev/null', shq(cfg.main.xray_bin), cfg.main.api_port));
			let traffic = {};
			try {
				for (let s in (json(r.out)?.stat ?? [])) {
					let m = match(s.name, /^outbound>>>(srv-[0-9]+)>>>traffic>>>(uplink|downlink)$/);
					if (!m)
						continue;
					let e = filter(idx.servers ?? [], (x) => x.tag == m[1])[0];
					if (!e)
						continue;
					traffic[e.id] ??= { up: 0, down: 0 };
					traffic[e.id][(m[2] == 'uplink') ? 'up' : 'down'] = int(s.value ?? 0);
				}
			}
			catch (e) { }
			// router clock: the UI counts uptime, ages and speed from it, not from the browser
			return { traffic, time: time() };
		}
	},

	log: {
		call: function() {
			let r = run("logread -e 'xvpn|xray' 2>/dev/null | tail -n 300");
			return { log: r.out };
		}
	},

	service: {
		args: { action: 'action' },
		call: function(req) {
			let action = req.args?.action;
			if (!(action in [ 'start', 'stop', 'restart' ]))
				return { ok: false, error: 'invalid action' };

			let uci = cursor();
			if (action == 'stop') {
				uci.set('xvpn', 'main', 'enabled', '0');
				uci.commit('xvpn');
				bg(`${INIT} stop; ${INIT} disable`);
			}
			else {
				uci.set('xvpn', 'main', 'enabled', '1');
				uci.commit('xvpn');
				bg(`${INIT} enable; ${INIT} restart`);
			}
			return { ok: true };
		}
	},

	// also without the daemon: error is set while the wanted rules are not applied
	firewall: {
		call: function() {
			return {
				want: readfile(FW_WANT_FILE), mode: readfile(FW_MODE_FILE), error: readfile(FW_ERROR_FILE),
			};
		}
	},
};

return { 'luci.xvpn': methods };
