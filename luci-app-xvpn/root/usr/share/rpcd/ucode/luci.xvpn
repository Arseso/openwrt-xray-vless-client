// SPDX-License-Identifier: MIT
// rpcd plugin for luci-app-xvpn: data that is available without the daemon.

'use strict';

import { readfile, popen } from 'fs';
import { cursor } from 'uci';
import { connect } from 'ubus';
import { load_config, read_json, run, shq, update_running, no_auto_ids, INDEX_FILE, ACTIVE_FILE } from 'xvpn.util';
import { all_servers, load_cache, load_status, due_in } from 'xvpn.subscription';
import { parse_link } from 'xvpn.links';

const CLI = '/usr/share/xvpn/cli.uc';
const INIT = '/etc/init.d/xvpn';

import { FW_WANT_FILE, FW_MODE_FILE, FW_ERROR_FILE, FW_WARN_FILE } from 'xvpn.util';

function bg(cmd) {
	system(`(${cmd}) >/dev/null 2>&1 </dev/null &`);
}

// LuCI cannot call the daemon itself: uhttpd adds ubus_rpc_session to the arguments
// and the ucode ubus object rejects arguments missing from its policy.
// A hung daemon must not stall rpcd (and with it all of LuCI) for the default 30 s.
// Without an answer daemon_error says why: 'timeout' — xvpnd is on ubus but busy, the call
// may still be done; 'not running' — there is no xvpnd object.
const UBUS_STATUS_TIMEOUT = 7;

// the log tab: lines of the system log looked through and sent
const LOG_SCAN = 2000, LOG_LINES = 300;
let daemon_error = null;

function daemon(method, args) {
	let conn = connect(null, 2);
	let r = conn?.call('xvpn', method, args ?? {});
	daemon_error = (r != null) ? null : (conn?.error(true) == UBUS_STATUS_TIMEOUT) ? 'timeout' : 'not running';
	return r;
}

const methods = {
	status: {
		call: function() {
			let d = daemon('status');
			// enabled and the router clock: the status tab needs no other call each poll
			let base = { enabled: cursor().get('xvpn', 'main', 'enabled') == '1', time: time() };
			if (d)
				return { ...base, running: true, ...d };
			// timeout: the daemon is there but did not answer in 2 s
			return { ...base, running: false, timeout: (daemon_error == 'timeout') };
		}
	},

	test: {
		call: function() {
			return daemon('test') ?? { ok: false, error: daemon_error };
		}
	},

	select: {
		args: { id: 'id' },
		call: function(req) {
			if (!req.args?.id)
				return { ok: false, error: 'invalid id' };
			let r = daemon('select', { id: req.args.id });
			if (!r)
				return { ok: false, error: daemon_error };
			// the daemon answers a bare ok: false for an id missing from its index
			if (r.ok === false && !r.error)
				r.error = 'unknown server';
			return r;
		}
	},

	// takes part in auto selection or not (health.no_auto): the daemon writes UCI and
	// restarts nothing
	set_auto: {
		args: { id: 'id', auto: true },
		call: function(req) {
			if (!req.args?.id || type(req.args?.auto) != 'bool')
				return { ok: false, error: 'invalid arguments' };
			let r = daemon('set_auto', { id: req.args.id, auto: req.args.auto });
			return r ?? { ok: false, error: daemon_error };
		}
	},

	servers: {
		call: function() {
			let cfg = load_config(), off = {};
			for (let id in no_auto_ids())
				off[id] = true;
			let list = map(all_servers(cfg), (s) => ({
				id: s.id, name: s.name, proto: s.proto, address: s.address, port: s.port,
				sub: s.sub, sub_name: s.sub_name, auto: !off[s.id],
			}));
			return { servers: list, active: trim(readfile(ACTIVE_FILE) ?? '') || null };
		}
	},

	subscriptions: {
		// updating: false — the caller takes the flag from status, do not ask the daemon
		args: { updating: true },
		call: function(req) {
			let cfg = load_config();
			let subs = map(cfg.subscriptions, (s) => {
				let c = load_cache(s.id), st = load_status(s.id);
				return {
					id: s.id, name: s.name, enabled: s.enabled,
					count: length(c?.servers ?? []), skipped: c?.skipped, format: c?.format,
					title: c?.title, updated: c?.updated,
					last_ok: st.last_ok, last_attempt: st.last_attempt, error: st.error,
					userinfo: st.userinfo, via: st.via,
					due_in: s.enabled ? due_in(s, c, st) : null,
				};
			});
			// router clock: the subscriptions tab counts the ages from it
			if (req.args?.updating === false)
				return { subscriptions: subs, time: time() };
			// the daemon also counts the moment before `cli.uc update` takes the lock
			let d = daemon('status');
			return { subscriptions: subs, updating: d ? !!d.updating : !!update_running(), time: time() };
		}
	},

	update: {
		args: { sid: 'sid' },
		call: function(req) {
			let sid = req.args?.sid || null;
			// the daemon is the single entry point: it updates, reloads and re-reads the index
			let r = daemon('update', sid ? { sid } : {});
			if (r)
				return r;
			// a busy daemon may be updating already: do not start a second update beside it
			if (daemon_error == 'timeout')
				return { ok: false, error: 'timeout' };

			// no daemon (service disabled or being restarted by procd): the lock in cli.uc
			// keeps it the one update at a time, the daemon picks up the reload by itself
			if (update_running())
				return { ok: false, error: 'busy' };
			bg(sprintf('/usr/bin/ucode %s update %s && %s running && %s reload', CLI, shq(sid ?? 'all'), INIT, INIT));
			return { ok: true };
		}
	},

	// checks share links for the manual list: what the backend makes of each one
	// (no outbound: it holds the credentials)
	parse_links: {
		args: { links: [] },
		call: function(req) {
			let links = req.args?.links;
			if (type(links) != 'array')
				return { error: 'invalid links' };
			return { links: map(slice(links, 0, 200), (l) => {
				let s = (type(l) == 'string') ? parse_link(l) : { error: 'not a link' };
				return s.error ? { error: s.error }
					: { id: s.hash, name: s.name, proto: s.proto, address: s.address, port: s.port };
			}) };
		}
	},

	access_points: {
		call: function() {
			let uci = cursor();
			let networks = [], ports = [], wifi = [];

			uci.foreach('network', 'interface', (s) => {
				if (s['.name'] == 'loopback' || match(s['.name'], /^wan/))
					return;
				push(networks, { name: s['.name'], proto: s.proto, device: s.device });
			});

			uci.foreach('network', 'device', (s) => {
				if (s.type != 'bridge')
					return;
				for (let p in (type(s.ports) == 'array' ? s.ports : (s.ports ? [ s.ports ] : [])))
					push(ports, { name: p, bridge: s.name });
			});

			uci.foreach('wireless', 'wifi-iface', (s) => {
				if (s.mode && s.mode != 'ap')
					return;
				let dev = uci.get_all('wireless', s.device) ?? {};
				push(wifi, {
					section: s['.name'], ssid: s.ssid, radio: s.device, band: dev.band,
					network: s.network, disabled: (s.disabled == '1' || dev.disabled == '1'),
					// the fixed name of a VPN SSID (DESIGN.md 7.2) or one set by the user
					ifname: s.ifname,
				});
			});

			return {
				networks, ports, wifi,
				flow_offloading: uci.get('firewall', '@defaults[0]', 'flow_offloading') == '1',
				flow_offloading_hw: uci.get('firewall', '@defaults[0]', 'flow_offloading_hw') == '1',
			};
		}
	},

	stats: {
		call: function() {
			let cfg = load_config(), idx = read_json(INDEX_FILE) ?? {};
			// expvar of the xray metrics section over loopback HTTP, no xray process is started;
			// a hung xray must not stall rpcd; the port of the running config (index)
			let r = run(sprintf('curl -s -m 1 http://127.0.0.1:%d/debug/vars 2>/dev/null', idx.ports?.api ?? cfg.main.api_port));
			let traffic = {};
			try {
				let out = json(r.out)?.stats?.outbound ?? {};
				for (let e in (idx.servers ?? [])) {
					let s = out[e.tag];
					if (s)
						traffic[e.id] = { up: int(s.uplink ?? 0), down: int(s.downlink ?? 0) };
				}
			}
			catch (e) { }
			// router clock: the UI counts uptime, ages and speed from it, not from the browser
			return { traffic, time: time() };
		}
	},

	log: {
		call: function() {
			// by the tag only: other lines may mention xvpn too (LuCI URLs in the log of uhttpd);
			// procd tags the output of an instance with the name of its binary: xray and
			// ucode (stdout and stderr of xvpnd, e.g. its stack traces); logread -e takes a
			// basic regex. rpcd waits for this call and serves nothing else meanwhile: logread
			// waits for logd, a stuck one is killed after 3 s (busybox has no timeout), and
			// it reads only the last LOG_SCAN lines
			let xray = replace(load_config().main.xray_bin, /.*\//, '');
			let re = sprintf(' (xvpn|ucode|%s)(\\[[0-9]+\\])?: ', replace(xray, /[^A-Za-z0-9_-]/g, '.') || 'xray');
			let r = run(sprintf('{ /sbin/logread -l %d 2>/dev/null & p=$!; (sleep 3; kill -9 $p) >/dev/null 2>&1 & w=$!; wait $p; kill $w; } 2>/dev/null | grep -E %s | tail -n %d',
				LOG_SCAN, shq(re), LOG_LINES));
			return { log: r.out };
		}
	},

	service: {
		args: { action: 'action' },
		call: function(req) {
			let action = req.args?.action;
			if (!(action in [ 'start', 'stop', 'restart' ]))
				return { ok: false, error: 'invalid action' };

			let uci = cursor();
			if (action == 'stop') {
				uci.set('xvpn', 'main', 'enabled', '0');
				uci.commit('xvpn');
				bg(`${INIT} stop; ${INIT} disable`);
			}
			else {
				uci.set('xvpn', 'main', 'enabled', '1');
				uci.commit('xvpn');
				bg(`${INIT} enable; ${INIT} restart`);
			}
			return { ok: true };
		}
	},

	// also without the daemon: error is set while the wanted rules are not applied
	firewall: {
		call: function() {
			return {
				want: readfile(FW_WANT_FILE), mode: readfile(FW_MODE_FILE), error: readfile(FW_ERROR_FILE),
				warning: readfile(FW_WARN_FILE),
			};
		}
	},
};

return { 'luci.xvpn': methods };
