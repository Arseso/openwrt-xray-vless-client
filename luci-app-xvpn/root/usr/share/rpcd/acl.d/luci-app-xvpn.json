{
	"luci-app-xvpn": {
		"description": "Grant access to XVPN",
		"read": {
			"ubus": {
				"luci.xvpn": [ "version", "status", "servers", "subscriptions", "access_points", "stats", "log", "firewall", "parse_links", "split", "xray", "xray_latest" ]
			},
			"uci": [ "xvpn", "firewall" ]
		},
		"write": {
			"ubus": {
				"luci.xvpn": [ "update", "service", "test", "speedtest", "select", "auto", "set_auto", "split_update" ]
			},
			"uci": [ "xvpn" ]
		}
	},
	"luci-app-xvpn-remote": {
		"description": "Grant the ubus uci calls for the XVPN config without luci-base (rpcd user of the desktop app)",
		"read": {
			"ubus": {
				"uci": [ "get", "changes" ],
				"session": [ "access", "destroy" ]
			}
		},
		"write": {
			"ubus": {
				"uci": [ "set", "add", "delete", "rename", "order", "revert", "commit", "apply", "confirm", "rollback" ]
			}
		}
	},
	"luci-app-xvpn-pkg": {
		"description": "Grant installing luci-app-xvpn from the desktop app (root only, see /usr/share/xvpn/pkg.sh)",
		"read": {
			"file": {
				"/usr/share/xvpn/pkg.sh list": [ "exec" ],
				"/usr/share/xvpn/pkg.sh status": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec" ]
			}
		},
		"write": {
			"file": {
				"/tmp/xvpn-pkg-*.ipk": [ "write" ],
				"/usr/share/xvpn/pkg.sh install *": [ "exec" ]
			},
			"ubus": {
				"file": [ "write", "exec", "remove" ]
			}
		}
	},
	"luci-app-xvpn-xray": {
		"description": "Grant installing xray-core from GitHub releases (root only, not the rpcd user of rpcd-user.sh)",
		"write": {
			"ubus": {
				"luci.xvpn": [ "xray_install", "xray_rollback" ]
			}
		}
	}
}
