{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xvpn",
  "version": "0.1.0",
  "identifier": "io.github.arseso.xvpn",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "xvpn",
        "width": 960,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "category": "Utility",
    "shortDescription": "Remote control of luci-app-xvpn",
    "longDescription": "Desktop remote control of luci-app-xvpn (xray VPN client) on an OpenWrt router: status, servers, subscriptions and settings over the router's ubus.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzNTM4Njk2NTM5RUU3RTMKUldUajU1NVRsb1pUUTNvZlJTZUYyR1lkaXJac3A0c05rTEJoMUVxMkdNcG1WL3J4RmFRMUJDTCsK",
      "endpoints": ["https://github.com/Arseso/openwrt-xray-vless-client/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
